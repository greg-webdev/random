  "main": "main.js",
  "bin": "server.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "npx electron-packager . FabricLauncher --platform=win32 --arch=x64 --overwrite --out=build --ignore=\"^/?(build|dist|instance|assets|libraries)($|/)\"",
