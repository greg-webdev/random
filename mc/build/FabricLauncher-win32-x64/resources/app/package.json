  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "fs-extra": "^11.4.0",
    "http-proxy": "^1.18.1",
    "open": "^11.0.1",
    "selfsigned": "^2.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-packager": "^17.1.2",
    "pkg": "^5.8.1"
  }
}
