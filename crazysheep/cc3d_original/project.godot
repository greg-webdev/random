boot_splash/image="uid://big08kqdoi028"
config/icon="uid://dx11833n71gqk"
config/windows_native_icon="res://crazyicon.ico"
boot_splash/minimum_display_time=3000

[autoload]

Global="*res://global.gd"
CheatMenu="*res://cheat_menu.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=480
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true
mouse_cursor/custom_image="uid://0fls4gdmimmo"
mouse_cursor/custom_image_hotspot=Vector2(16, 0)

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=3
environment/screen_space_reflection/roughness_quality=2

