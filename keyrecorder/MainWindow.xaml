<Window x:Class="KeyRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyRecorder"
        mc:Ignorable="d"
        Title="KeyRecorder - Global Keystroke &amp; Multi-Key Macro Recorder"
        Height="680" Width="960"
        MinHeight="520" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Foreground="#E6EDF3"
        FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#30363D"/>
        </Style>

        <!-- Button Base Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30363D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B949E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Recording Button Style (Neon Emerald/Cyan) -->
        <Style x:Key="RecordStartButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00B4D8" Offset="0"/>
                        <GradientStop Color="#0077B6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#00B4D8" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Recording Button Style (Vivid Red) -->
        <Style x:Key="RecordStopButton" TargetType="Button" BasedOn="{StaticResource RecordStartButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="16" Opacity="0.6" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play Macro Button Style (Vibrant Emerald/Purple) -->
        <Style x:Key="PlayMacroButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Macro Button Style -->
        <Style x:Key="StopMacroButton" TargetType="Button" BasedOn="{StaticResource PlayMacroButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#238636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar (Record & Play Macro) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer & Info Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: App Title & Top Bar Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1F6FEB" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="⌨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KeyRecorder &amp; Macro Engine" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
                        <Border Background="#30363D" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MULTI-KEY CHORDS • MACRO PLAYBACK" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="F4 = Record | F8 = Play Macro | Supports holding multiple keys together" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Top Right Options -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkAlwaysOnTop" Content="Always on Top" Foreground="#C9D1D9" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
                <CheckBox x:Name="ChkSoundFeedback" Content="Sound Cues" IsChecked="True" Foreground="#C9D1D9" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkSoundFeedback_Changed" Unchecked="ChkSoundFeedback_Changed"/>
                <Button x:Name="BtnHelp" Content="?" Width="28" Height="28" Padding="0" Style="{StaticResource ModernButton}" ToolTip="How to use KeyRecorder &amp; Macros" Click="BtnHelp_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Dual Action Panel (Record F4 & Play Macro F8) -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Primary Buttons & Status -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Record Toggle Button (F4) -->
                    <Button x:Name="BtnRecordToggle" Style="{StaticResource RecordStartButton}" Margin="0,0,10,0" Click="BtnRecordToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtRecordIcon" Text="●" FontSize="16" Margin="0,-1,8,0" Foreground="#00F5A0"/>
                            <TextBlock x:Name="TxtRecordLabel" Text="RECORD" FontWeight="Bold"/>
                            <Border Background="#1B2838" CornerRadius="4" Padding="5,2" Margin="8,0,0,0">
                                <TextBlock Text="F4" FontWeight="Bold" FontSize="11" Foreground="#58A6FF"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- 2. Play Macro Button (F8) -->
                    <Button x:Name="BtnPlayMacroToggle" Grid.Column="1" Style="{StaticResource PlayMacroButton}" Margin="0,0,14,0" Click="BtnPlayMacroToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtPlayIcon" Text="▶" FontSize="14" Margin="0,-1,8,0" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtPlayLabel" Text="PLAY MACRO" FontWeight="Bold"/>
                            <Border Background="#064E3B" CornerRadius="4" Padding="5,2" Margin="8,0,0,0">
                                <TextBlock Text="F8" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Center: Status Badge & Live Info -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="BorderStatusBadge" Background="#21262D" CornerRadius="12" Padding="10,3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="PulseIndicator" Width="8" Height="8" Fill="#8B949E" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtStatus" Text="STANDBY" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtTimer" Text="00:00.0" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtEventCount" Text="0 events" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtLiveEventFeedback" Text="Press F4 to record or F8 to play current macro." FontSize="11.5" Foreground="#7D8590" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right: Quick Copy / Save / Clear -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCopy" Content="📋 Copy Text" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="BtnCopy_Click" ToolTip="Copy instructions to clipboard"/>
                        <Button x:Name="BtnSaveMacroProfile" Content="💾 Save Macro" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnSaveMacroProfile_Click" ToolTip="Save to Macro Library"/>
                        <Button x:Name="BtnClear" Content="🗑️ Clear" Style="{StaticResource ModernButton}" Click="BtnClear_Click" ToolTip="Clear recorded history"/>
                    </StackPanel>
                </Grid>

                <!-- Sub-bar: Playback Parameters (Speed, Repeat, Countdown) -->
                <Border Grid.Row="1" Background="#0D1117" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speed Selection -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="⚡ Play Speed:" Foreground="#8B949E" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbPlaybackSpeed" Width="100" Height="26" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" FontSize="11.5">
                                <ComboBoxItem Content="0.5x (Slow)"/>
                                <ComboBoxItem Content="1.0x (Normal)" IsSelected="True"/>
                                <ComboBoxItem Content="1.25x"/>
                                <ComboBoxItem Content="1.5x (Fast)"/>
                                <ComboBoxItem Content="2.0x (Double)"/>
                                <ComboBoxItem Content="3.0x (Ultra)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Repeat Loops Selection -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="🔁 Repeat:" Foreground="#8B949E" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbLoopCount" Width="110" Height="26" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" FontSize="11.5">
                                <ComboBoxItem Content="1 time" IsSelected="True"/>
                                <ComboBoxItem Content="2 times"/>
                                <ComboBoxItem Content="3 times"/>
                                <ComboBoxItem Content="5 times"/>
                                <ComboBoxItem Content="10 times"/>
                                <ComboBoxItem Content="Infinite 🔁"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Countdown Prep -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <CheckBox x:Name="ChkPrepCountdown" Content="3s Prep Countdown (Switch Focus)" IsChecked="True" Foreground="#C9D1D9" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Smart Chord Indicator -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkSmartChords" Content="Group simultaneous keys ('and')" IsChecked="True" Foreground="#58A6FF" FontSize="11.5" VerticalAlignment="Center" Checked="FormattingOption_Changed" Unchecked="FormattingOption_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Main Content Tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Formatted Instructions (Primary User View) -->
            <TabItem Header="Instructions &amp; Macro Script">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Format Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Format Preset:" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbFormatPreset" Width="190" Height="26" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" SelectionChanged="CmbFormatPreset_SelectionChanged">
                                    <ComboBoxItem Content="Comma Separated (Inline)" IsSelected="True"/>
                                    <ComboBoxItem Content="Line by Line (With commas)"/>
                                    <ComboBoxItem Content="Numbered Step List"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Connector:" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbConnector" Width="85" Height="26" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" SelectionChanged="CmbConnector_SelectionChanged">
                                    <ComboBoxItem Content=" and " IsSelected="True"/>
                                    <ComboBoxItem Content=" + "/>
                                    <ComboBoxItem Content=" &amp; "/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkInitialDelay" Content="Include Initial Wait" Foreground="#8B949E" FontSize="12" Margin="0,0,16,0" Checked="FormattingOption_Changed" Unchecked="FormattingOption_Changed"/>
                                <TextBlock x:Name="TxtStatsInfo" Text="0 steps generated" FontSize="12" Foreground="#58A6FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Instructions Output / Macro Editor Box -->
                        <TextBox x:Name="TxtOutput" Grid.Row="1"
                                 Background="#0D1117" Foreground="#58A6FF"
                                 BorderBrush="#30363D" BorderThickness="1"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13.5"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12"
                                 SelectionBrush="#1F6FEB"
                                 TextChanged="TxtOutput_TextChanged"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Saved Macro Profiles -->
            <TabItem Header="Macro Library (Saved Profiles)">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Macro List -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Saved Macros:" FontWeight="Bold" Foreground="#F0F6FC" FontSize="13" Margin="0,0,0,8"/>

                            <ListBox x:Name="ListSavedMacros" Grid.Row="1"
                                     Background="#0D1117" Foreground="#E6EDF3"
                                     BorderBrush="#30363D" BorderThickness="1"
                                     SelectionChanged="ListSavedMacros_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#58A6FF" FontSize="13"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}" Foreground="#8B949E" FontSize="11"/>
                                            <TextBlock Text="{Binding StepCount, StringFormat='Steps: {0}'}" Foreground="#7EE787" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnRefreshMacros" Content="🔄 Refresh" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnRefreshMacros_Click"/>
                                <Button x:Name="BtnDeleteMacro" Content="🗑️ Delete" Style="{StaticResource ModernButton}" Click="BtnDeleteMacro_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Right: Preview & Load Selected Macro -->
                        <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSelectedMacroTitle" Text="Select a macro to preview" FontWeight="Bold" Foreground="#F0F6FC" FontSize="14"/>
                                    <TextBlock x:Name="TxtSelectedMacroDetails" Text="No macro selected." Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBox x:Name="TxtSelectedMacroPreview" Grid.Row="1"
                                         Background="#161B22" Foreground="#C9D1D9"
                                         BorderBrush="#30363D" BorderThickness="1"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Padding="8"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="BtnLoadToEditor" Content="📥 Load to Editor &amp; Player" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="BtnLoadToEditor_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: Raw Keystroke Event Log -->
            <TabItem Header="Raw Keystroke Log">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Chronological raw key press and release timeline:" Foreground="#8B949E" FontSize="12" Margin="0,0,0,8"/>

                        <ListBox x:Name="ListRawEvents" Grid.Row="1"
                                 Background="#0D1117" Foreground="#E6EDF3"
                                 BorderBrush="#30363D" BorderThickness="1"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding IsKeyDown, StringFormat={}{0}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding KeyName}" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimestampMs, StringFormat={}+{0} ms}" Foreground="#7EE787" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding VirtualKeyCode, StringFormat=VK: 0x{0:X2}}" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: Template & Customization -->
            <TabItem Header="Settings &amp; Templates">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Format &amp; Multi-Key Chord Settings" FontSize="15" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,12"/>

                            <TextBlock Text="Hold Key Template (Use {key} and {ms}):" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTemplateHold" Text="hold {key} for {ms}ms" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8,6" FontSize="13" Margin="0,0,0,14" TextChanged="Template_TextChanged"/>

                            <TextBlock Text="Release Gap Template (Use {ms}):" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTemplateRelease" Text="release for {ms}ms" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8,6" FontSize="13" Margin="0,0,0,14" TextChanged="Template_TextChanged"/>

                            <TextBlock Text="Instruction Separator:" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTemplateSeparator" Text=", " Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8,6" FontSize="13" Margin="0,0,0,14" TextChanged="Template_TextChanged"/>

                            <TextBlock Text="Multi-Key Chord Stagger Tolerance (Milliseconds):" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtChordTolerance" Text="45" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8,6" FontSize="13" Margin="0,0,0,14" TextChanged="Template_TextChanged"/>

                            <Button Content="Reset Settings to Default" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Click="BtnResetTemplates_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Row 3: Footer Bar & Toast Banner -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Toast / Helper Notification -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtToastMessage" Text="Ready. F4 = Record | F8 = Play Macro." Foreground="#8B949E" FontSize="12"/>
            </StackPanel>

            <!-- Right: Status / Version -->
            <TextBlock Grid.Column="1" Text="KeyRecorder &amp; Macro Player v2.0 • Global F4/F8 Hooks Active" Foreground="#484F58" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
